{
	"name": "saddle-debug",
	"displayName": "Saddle — Minecraft Datapack Debugger",
	"description": "Debug Minecraft datapack .mcfunction files through the Saddle mod: breakpoints (incl. macro lines), stepping, call stacks, live scoreboard/storage/entity NBT editing, a command console, run-from-file and reload on save.",
	"version": "1.2.0",
	"publisher": "d1n0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/d1n-0/saddle.git",
		"directory": "vscode-extension"
	},
	"homepage": "https://github.com/d1n-0/saddle#readme",
	"bugs": {
		"url": "https://github.com/d1n-0/saddle/issues"
	},
	"icon": "icon.png",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Debuggers"
	],
	"main": "./extension.js",
	"activationEvents": [
		"onDebugResolve:saddle",
		"onDebugInitialConfigurations",
		"onLanguage:mcfunction"
	],
	"contributes": {
		"views": {
			"debug": [
				{
					"type": "webview",
					"id": "saddleLiveWatch",
					"name": "Saddle Watch",
					"when": "inDebugMode"
				}
			]
		},
		"configuration": {
			"title": "Saddle",
			"properties": {
				"saddle.liveWatchRefreshInterval": {
					"type": "number",
					"default": 1000,
					"minimum": 200,
					"description": "Refresh interval (ms) for the Saddle Live Watch view."
				},
				"saddle.reloadOnSave": {
					"type": "boolean",
					"default": false,
					"description": "Reload datapacks (like /reload) whenever a datapack file (pack.mcmeta, or anything under the data/ folder next to it) is saved while attached."
				},
				"saddle.runFunctionExecutor": {
					"type": "string",
					"default": "",
					"markdownDescription": "Entity that runs functions started with **Saddle: Run Function From File**, e.g. `@p` or a player name — the command becomes `execute as <executor> at @s run function ...`. Empty runs them as the server, like the Debug Console."
				}
			}
		},
		"keybindings": [
			{
				"command": "saddle.runFunction",
				"key": "ctrl+alt+enter",
				"mac": "cmd+alt+enter",
				"when": "editorTextFocus && editorLangId == mcfunction"
			}
		],
		"menus": {
			"editor/title/run": [
				{
					"command": "saddle.runFunction",
					"when": "resourceExtname == .mcfunction",
					"group": "navigation@1"
				}
			],
			"editor/context": [
				{
					"command": "saddle.runFunction",
					"when": "resourceExtname == .mcfunction",
					"group": "navigation@1"
				}
			],
			"explorer/context": [
				{
					"command": "saddle.runFunction",
					"when": "resourceExtname == .mcfunction",
					"group": "saddle@1"
				}
			],
			"commandPalette": [
				{
					"command": "saddle.runFunction",
					"when": "resourceExtname == .mcfunction"
				},
				{
					"command": "saddle.watchNode",
					"when": "false"
				},
				{
					"command": "saddle.renameWatch",
					"when": "false"
				}
			],
			"webview/context": [
				{
					"command": "saddle.renameWatch",
					"when": "webviewId == 'saddleLiveWatch' && webviewSection == 'saddleWatchPin'"
				},
				{
					"command": "saddle.watchNode",
					"when": "webviewId == 'saddleLiveWatch' && webviewSection == 'saddleWatchNode'"
				}
			],
			"view/title": [
				{
					"command": "saddle.pin",
					"when": "view == saddleLiveWatch",
					"group": "navigation@1"
				},
				{
					"command": "saddle.liveRefresh",
					"when": "view == saddleLiveWatch",
					"group": "navigation@2"
				}
			]
		},
		"languages": [
			{
				"id": "mcfunction",
				"extensions": [
					".mcfunction"
				],
				"aliases": [
					"mcfunction",
					"Minecraft Function"
				]
			}
		],
		"breakpoints": [
			{
				"language": "mcfunction"
			}
		],
		"debuggers": [
			{
				"type": "saddle",
				"label": "Saddle: Minecraft Datapack",
				"languages": [
					"mcfunction"
				],
				"configurationAttributes": {
					"attach": {
						"properties": {
							"host": {
								"type": "string",
								"description": "Host the Saddle DAP server listens on (-Dsaddle.host).",
								"default": "127.0.0.1"
							},
							"port": {
								"type": "number",
								"description": "Port the Saddle DAP server listens on (-Dsaddle.port).",
								"default": 16352
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "saddle",
						"request": "attach",
						"name": "Attach to Minecraft (Saddle)",
						"host": "127.0.0.1",
						"port": 16352
					}
				],
				"configurationSnippets": [
					{
						"label": "Saddle: Attach to Minecraft",
						"description": "Attach to a running Minecraft server/world with the Saddle mod",
						"body": {
							"type": "saddle",
							"request": "attach",
							"name": "Attach to Minecraft (Saddle)",
							"host": "127.0.0.1",
							"port": 16352
						}
					}
				]
			}
		],
		"commands": [
			{
				"command": "saddle.runCommand",
				"title": "Saddle: Run Minecraft Command"
			},
			{
				"command": "saddle.getScoreboard",
				"title": "Saddle: Show Scoreboard"
			},
			{
				"command": "saddle.setScore",
				"title": "Saddle: Set Scoreboard Score"
			},
			{
				"command": "saddle.listEntities",
				"title": "Saddle: List Entities"
			},
			{
				"command": "saddle.getData",
				"title": "Saddle: Get NBT Data (storage/entity/block)"
			},
			{
				"command": "saddle.setData",
				"title": "Saddle: Set NBT Data (storage/entity/block)"
			},
			{
				"command": "saddle.getBlock",
				"title": "Saddle: Inspect Block"
			},
			{
				"command": "saddle.showTrace",
				"title": "Saddle: Show Execution Trace"
			},
			{
				"command": "saddle.pin",
				"title": "Saddle: Watch Expression (Pin to Variables)",
				"icon": "$(add)"
			},
			{
				"command": "saddle.unpin",
				"title": "Saddle: Unpin Watched Expression"
			},
			{
				"command": "saddle.liveRefresh",
				"title": "Saddle: Refresh Live Watch",
				"icon": "$(refresh)"
			},
			{
				"command": "saddle.watchNode",
				"title": "Add to Saddle Watch"
			},
			{
				"command": "saddle.renameWatch",
				"title": "Rename"
			},
			{
				"command": "saddle.runFunction",
				"title": "Saddle: Run Function From File",
				"shortTitle": "Run Function",
				"icon": "$(play)"
			},
			{
				"command": "saddle.reload",
				"title": "Saddle: Reload Datapacks"
			},
			{
				"command": "saddle.toggleReloadOnSave",
				"title": "Saddle: Toggle Reload on Save"
			}
		]
	}
}
