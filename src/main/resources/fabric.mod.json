{
	"schemaVersion": 1,
	"id": "saddle",
	"version": "${version}",
	"name": "Saddle",
	"description": "Debug Adapter Protocol (DAP) server for debugging Minecraft datapack functions from editors like VS Code: breakpoints, stepping, call stacks, command evaluation, run-from-file and reload on save, plus /deploy to ship a map without player data.",
	"authors": [
		"d1n0"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/saddle-datapack-debugger",
		"sources": "https://github.com/d1n-0/saddle",
		"issues": "https://github.com/d1n-0/saddle/issues"
	},
	"license": "MIT",
	"icon": "assets/saddle/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.d1n0.saddle.Saddle"
		],
		"client": [
			"me.d1n0.saddle.SaddleClient"
		]
	},
	"mixins": [
		"saddle.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.0",
		"minecraft": ["~26.2", "~26.3"],
		"java": ">=25",
		"fabric-api": "*"
	},
	"accessWidener": "saddle.classtweaker"
}
